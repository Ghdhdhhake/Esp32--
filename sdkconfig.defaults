# Defaults for the device dashboard.

# Bluetooth is off on purpose.
#
# The dashboard used to run NimBLE in three roles at once (observer,
# broadcaster, peripheral) so a single board could scan for advertisers and be
# discovered by a phone. That cost far more than it was worth once the AI chat
# panel arrived:
#
#   - 56 KB of DRAM was reserved up front for the BT controller
#     (CONFIG_BTDM_RESERVE_DRAM = 0xDB5C) and never came back
#   - another ~34 KB went to the NimBLE host task, the MSYS/ACL buffers and the
#     30-entry advertiser table
#   - ~140 KB of flash went to libbtdm_app.a plus the NimBLE host
#
# Dropping it takes the free heap from ~96 KB to ~185 KB, which is what makes
# the HTTPS client behind the chat panel comfortable rather than marginal.
CONFIG_BT_ENABLED=n

# The chat panel needs a persistent browser connection. Polling an endpoint
# every couple of seconds cannot stream a token-by-token answer, and one
# long-lived socket costs a fraction of what repeated polling does.
CONFIG_HTTPD_WS_SUPPORT=y

# The application outgrew the 1 MiB default slot; use the custom layout.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
